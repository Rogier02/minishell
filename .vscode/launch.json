{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "(gdb) Launch - Parent Only",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/./minishell",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		},
		{
			"name": "(gdb) Launch - Follow Child",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/./minishell",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				},
				{
					"description": "Follow child processes on fork",
					"text": "-gdb-set follow-fork-mode child",
					"ignoreFailures": false
				},
				{
					"description": "Don't detach from child processes",
					"text": "-gdb-set detach-on-fork off",
					"ignoreFailures": false
				}
			]
		},
		{
			"name": "(gdb) Launch - Debug Both Parent & Child",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/./minishell",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				},
				{
					"description": "Don't detach from child processes",
					"text": "-gdb-set detach-on-fork off",
					"ignoreFailures": false
				},
				{
					"description": "Follow parent by default",
					"text": "-gdb-set follow-fork-mode parent",
					"ignoreFailures": false
				}
			]
		}
	]
}